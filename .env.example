# Copy to .env (or run setup.ps1). Never commit real keys or credential files.
# setup.ps1 generates this session secret locally when it is empty.
CSGO_SECRET_KEY=
PORT=5001
CSGO_HTTPS=0

# Separate teammate keys. Keep each agent on its own authorized credentials.
# Advising belongs to its own Google Cloud project.
ADVISING_API_KEY=
# Tutoring and Success share a Cloud project, but keep their separate keys.
TUTORING_API_KEY=
SUCCESS_API_KEY=
# Optional approved-model overrides; blank preserves existing model defaults.
ADVISING_MODEL=
TUTORING_MODEL=
SUCCESS_MODEL=

# Career uses ADC, NOT a Gemini API key. The example targets development RC2.
GOOGLE_CLOUD_PROJECT=cosc-490
GOOGLE_CLOUD_LOCATION=us-west1
CAREER_REASONING_ENGINE_ID=6244403611070103552
# Optional: absolute path to an authorized, private service-account JSON file.
# Otherwise use gcloud auth application-default login on this computer.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional alternative for Success only, if using Vertex instead of an API key.
# SUCCESS_API_KEY takes precedence. This does not deploy or select an engine.
SUCCESS_USE_VERTEXAI=false

# Existing deployed Tutoring and Success agents use ADC.
# An engine ID selects runtime mode ahead of the corresponding API key.
# Clear its engine ID to select the existing local API-key implementation.
TUTORING_REASONING_ENGINE_ID=4882328606581194752
TUTORING_RUNTIME_PROJECT=cosc-490
TUTORING_RUNTIME_LOCATION=us-west1
SUCCESS_REASONING_ENGINE_ID=3125784014418345984
SUCCESS_RUNTIME_PROJECT=cosc-490
SUCCESS_RUNTIME_LOCATION=us-west1
